{
  "manifest_version": 3,
  "name": "Nova Island · Media Sources",
  "version": "1.0.0",
  "description": "Identify the site playing media in Nova Island without switching tabs.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://open.spotify.com/*",
    "https://music.apple.com/*",
    "https://*.soundcloud.com/*",
    "https://*.vimeo.com/*",
    "https://*.twitch.tv/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Nova Island media companion"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://open.spotify.com/*",
        "https://music.apple.com/*",
        "https://*.soundcloud.com/*",
        "https://*.vimeo.com/*",
        "https://*.twitch.tv/*"
      ],
      "js": [
        "media.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "incognito": "not_allowed"
}
