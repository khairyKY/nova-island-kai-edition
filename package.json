{
  "name": "nova-island",
  "version": "1.7.6",
  "description": "A living island for your Windows desktop",
  "main": "nova.js",
  "scripts": {
    "prepare:phoenix": "electron tools/prepare-phoenix.cjs",
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:store": "set \"ELECTRON_BUILDER_WINDOWS_KITS_PATH=C:\\Program Files (x86)\\Windows Kits\\10\\bin\\10.0.22621.0\\x64\" && electron-builder --win appx"
  },
  "author": "AmerTech",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "com.khairyky.nova-island-kai",
    "productName": "Nova Island Kai Edition",
    "copyright": "Copyright © 2026 Nova Island by AmerTech; Kai Edition changes by Khairy Shaheen",
    "electronLanguages": [
      "en-US",
      "ar"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "build/icon.png",
      "build/icon.ico",
      "!promo/**",
      "!dist/**",
      "!*.cmd",
      "!setup-log.txt",
      "!**/*.map",
      "!helper/*.cs",
      "!helper/*.cmd",
      "!.*/**",
      "!NEXT-RELEASE.md",
      "!contrib/**",
      "!keys/**",
      "!nova-island-plugins/**",
      "!local-plugins/**",
      "!tools/**",
      "!upstream/**",
      "!scripts/**",
      "!news.json",
      "!build/appx/**",
      "!store/**",
      "!assets/phoenix-v1/*.png",
      "!assets/phoenix-v1/generation.json",
      "!assets/zaher-v1/*.png",
      "!assets/zaher-v1/generation.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "khairyKY",
      "repo": "nova-island-kai-edition"
    },
    "asarUnpack": [
      "helper/nova-helper.exe",
      "helper/browser-media-host.exe"
    ],
    "extraResources": [
      { "from": "local-plugins/kais-flow.nvp", "to": "bundled-plugins/kais-flow.nvp" }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "Nova Island Kai Edition"
    },
    "nsis": {
      "oneClick": false,
      "artifactName": "Nova-Island-Kai-Edition-Setup-${version}.${ext}",
      "license": "LICENSE",
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Nova Island Kai Edition",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Nova Island Kai Edition ${version} portable.exe"
    },
    "appx": {
      "identityName": "AmerTech.NovaIsland",
      "publisher": "CN=8BA7D487-B6B1-48CC-A9BE-EAC4A654C421",
      "publisherDisplayName": "AmerTech",
      "applicationId": "NovaIsland",
      "displayName": "Nova Island",
      "backgroundColor": "transparent",
      "languages": [
        "en-US",
        "ar"
      ],
      "addAutoLaunchExtension": true,
      "artifactName": "Nova-Island-${version}-Store.${ext}",
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "node-ical": "^0.27.3"
  }
}
